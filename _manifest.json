{
  "manifest_version": 2,
  "id": "babyQ.maibot_reply-mark",
  "version": "0.5.4",
  "name": "回复标记插件",
  "description": "回复消息时，在被回复的那条消息上贴个表情，一眼就能看出它在回谁。",
  "author": {
    "name": "BabyQ",
    "url": "https://github.com/52-Moyna"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/52-Moyna/maibot_plugin-Response",
    "homepage": "https://github.com/52-Moyna/maibot_plugin-Response"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.5.1",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "capabilities": [],
  "plugin_type": "media",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "✅",
      "background": "#2f9e44"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
